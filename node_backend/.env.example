[TEMPLATE]
PORT=8006
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL connection string (required — the backend fails loudly without it).
# Examples:
#   Local:  postgresql://postgres:postgres@localhost:5432/compliance
#   Neon:   postgresql://user:password@ep-xxx.aws.neon.tech/compliance?sslmode=require
DATABASE_URL=

# Optional pool tuning
# PG_POOL_MAX=10
# PG_CONNECT_TIMEOUT_MS=15000
